<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Identity keys. Spelled out because GENERATE_INFOPLIST_FILE is NO for this target, so
	     Xcode injects nothing: without CFBundleIdentifier the built bundle cannot be installed
	     at all, which is what stopped the first launch this app ever had. The values come from
	     build settings so the identifier lives in one place. -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Hardset</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Required for AlarmKit. Without this key AlarmManager cannot schedule at all: the
	     framework fails at runtime with "Client has not provided an NSAlarmKitUsageDescription
	     value". There is no AlarmKit entitlement and no Xcode capability to add. -->
	<key>NSAlarmKitUsageDescription</key>
	<string>Hardset uses alarms so your rest timer still alerts you when the app is closed, silenced, or in Focus.</string>

	<!-- Remote notifications: CKSyncEngine needs them to learn about changes from other
	     devices. Declared here and enabled as a capability on the target. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
