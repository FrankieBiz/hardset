* text=auto

# Keep source and project files byte-stable when the repository is edited on Windows.
*.swift text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.plist text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.json text eol=lf
*.xcprivacy text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
